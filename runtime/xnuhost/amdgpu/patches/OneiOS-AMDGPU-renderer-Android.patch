+int
+amdgpu_renderer_set_response_pool(struct virgl_context *vctx, xh_gpu_pool *pool)
+{
+   struct amdgpu_context *ctx = to_amdgpu_context(to_drm_context(vctx));
+   if (!pool || ctx->base.shmem)
+      return -EINVAL;
+   ctx->response_pool = pool;
+   return 0;
+}
+
+static int
+amdgpu_response_blob(struct amdgpu_context *ctx, uint64_t size,
+                     uint32_t flags, struct virgl_context_blob *blob)
+{
+   struct drm_context *dctx = &ctx->base;
+   xh_gpu_pool *pool = ctx->response_pool;
+   if (flags != VIRGL_RENDERER_BLOB_FLAG_USE_MAPPABLE || dctx->shmem ||
+       dctx->blob_size || size < sizeof(*ctx->shmem) || size > UINT32_MAX)
+      return -EINVAL;
+
+   int fd = os_dupfd_cloexec(pool->fd);
+   if (fd < 0)
+      return -errno;
+
+   int ret = xh_gpu_pool_map(pool, size, &ctx->response);
+   if (ret) {
+      close(fd);
+      return ret;
+   }
+
+   uint8_t *address = ctx->response.address;
+   dctx->shmem = (struct vdrm_shmem *)address;
+   dctx->shmem->rsp_mem_offset = sizeof(*ctx->shmem);
+   dctx->rsp_mem = address + sizeof(*ctx->shmem);
+   dctx->rsp_mem_sz = size - sizeof(*ctx->shmem);
+   dctx->blob_size = size;
+   dctx->borrowed_shmem = true;
+
+   blob->type = VIRGL_RESOURCE_FD_SHM;
+   blob->u.fd = fd;
+   blob->map_ptr = address;
+   blob->fd_offset = pool->offset + ctx->response.offset;
+   blob->map_info = VIRGL_RENDERER_MAP_CACHE_CACHED;
+   return 0;
+}
